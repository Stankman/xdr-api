APP_ENV=development
APP_NAME=XDR API
APP_URL=http://localhost:9000
APP_PORT=9000
APP_PUBLIC_URL=http://localhost:4200

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=turbo
MYSQL_USERNAME=root
MYSQL_PASSWORD=Azure

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_THREADS=4

# Required in production. Leave empty only for local development, where a process-only key is used.
TOKEN_SECRET=4SRZRPXbiZxGy1LGP73vuLlXj6ab0LxEMcY9KUIYzIQ
TOKEN_ISSUER=XDR-Issuer
TOKEN_DURATION=1800s

# Registration and recovery require a working SMTP service and APP_PUBLIC_URL.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="XDR <no-reply@xdr.local>"
