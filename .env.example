APP_ENV=development
APP_NAME=XDR API
APP_URL=http://localhost:9000
APP_PORT=9000
APP_PUBLIC_URL=http://localhost:5175

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=xdr
MYSQL_USERNAME=xdr
MYSQL_PASSWORD=

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_THREADS=4

# Required in production. Leave empty only for local development, where a process-only key is used.
TOKEN_SECRET=
TOKEN_ISSUER=XDR-Issuer
TOKEN_DURATION=1800s

# Registration and recovery require a working SMTP service and APP_PUBLIC_URL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# A Turbo Admin passkey session is supplied separately on each authenticated ACP request.
TURBO_ADMIN_BASE_URL=http://127.0.0.1:8090
TURBO_TIMEOUT_MS=5000
